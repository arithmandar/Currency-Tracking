<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ C:\Projects\WoW\Bin\Interface\FrameXML\UI.xsd">
	<Button name="CurrencyTrackingButtonTemplate" movable="true" enableMouse="true" virtual="true">
		<Size>
			<AbsDimension x="50" y="20"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentTexture" parentKey="Texture" />
			</Layer>
			<Layer level="BORDER">
				<FontString name="$parentCount" parentKey="Count" inherits="GameFontHighlightRight" text="100">
					<Anchors>
						<Anchor point="LEFT" >
							<Offset x="0" y="0"/>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentIcon">
					<Size>
						<AbsDimension x="15" y="15"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentCount" relativePoint="RIGHT">
							<Offset x="2" y="0"/>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Button enableMouse="true" parentKey="LinkButton">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentIcon">
						<Offset x="0" y="0"/>
					</Anchor>
					<Anchor point="BOTTOMRIGHT" relativeTo="$parentIcon">
						<Offset x="0" y="0"/>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnEnter>
						GameTooltip:SetOwner(self, "ANCHOR_RIGHT");
						if (self:GetParent().isCurrency) then
							GameTooltip:SetCurrencyToken(self:GetParent().index);
						elseif (self:GetParent().isItem) then
							local name = self:GetParent().itemName;
							GameTooltip:SetText(name, 1, 1, 1, nil, false);
						end
					</OnEnter>
					<OnClick>
						if (self:GetParent().isCurrency) then
							HandleModifiedItemClick(GetCurrencyListLink(self:GetParent().index));
						end
					</OnClick>
					<OnLeave>
						GameTooltip:Hide();
					</OnLeave>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				local name = self:GetName();
				self.count = _G[name.."Count"];
				self.icon = _G[name.."Icon"];
				self.highlight = _G[name.."Highlight"];
				self:RegisterForDrag("LeftButton");
				self:RegisterForClicks("LeftButtonDown", "RightButtonDown");
			</OnLoad>
		</Scripts>
		<ButtonText>
			<Anchors>
				<Anchor point="CENTER">
					<Offset>
						<AbsDimension x="0" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontNormal"/>
		<HighlightTexture name="$parentHighlight" file="Interface\QuestFrame\UI-QuestTitleHighlight" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT">
					<Offset x="0" y="0"/>
				</Anchor>
				<Anchor point="BOTTOMRIGHT">
					<Offset x="0" y="0"/>
				</Anchor>
			</Anchors>
		</HighlightTexture>
	</Button>

